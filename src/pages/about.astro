---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About Coach Chris | Sunshine Chess">
    <!-- PAGE HERO -->
    <section class="relative bg-gradient-to-br from-yellow-100 via-orange-50 to-coral-50 py-20 lg:py-28 overflow-hidden">
        <div class="absolute top-20 left-10 w-32 h-32 bg-yellow-300 rounded-full opacity-40 blur-2xl animate-pulse"></div>
        <div class="absolute bottom-20 right-10 w-40 h-40 bg-coral-300 rounded-full opacity-30 blur-3xl animate-pulse" style="animation-delay: 1s;">
        </div>

        <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10">
            <div class="grid lg:grid-cols-2 gap-12 items-center">
                <!-- Photo -->
                <div class="relative">
                    <div
                        class="bg-gradient-to-br from-yellow-300 to-orange-400 rounded-[2.5rem] p-3 transform -rotate-2 hover:rotate-0 transition-transform duration-500 shadow-2xl"
                    >
                        <div class="bg-white rounded-[2rem] overflow-hidden aspect-[4/5]">
                            <img
                                src="img/Coach Chris.JPG"
                                alt="Coach Chris teaching chess to students in Florida"
                                class="w-full h-full object-cover"
                                loading="eager"
                            />
                        </div>
                    </div>
                    <!-- Floating Badge -->
                    <div
                        class="absolute -bottom-4 -right-4 bg-yellow-400 text-slate-800 px-6 py-3 rounded-full font-bold shadow-lg transform rotate-6 text-lg"
                        style="font-family: 'Montserrat', sans-serif;"
                    >
                        30+ Years! 🎉
                    </div>
                </div>

                <!-- Intro -->
                <div>
                    <span
                        class="inline-block bg-yellow-300 text-slate-800 px-5 py-2 rounded-full font-bold text-sm mb-4"
                        style="font-family: 'Montserrat', sans-serif;"
                    >
                        👋 MEET YOUR COACH
                    </span>
                    <h1
                        class="text-4xl md:text-5xl lg:text-6xl font-bold text-slate-800 leading-tight mb-6"
                        style="font-family: 'Montserrat', sans-serif;"
                    >
                        I'm <span class="text-orange-500">Coach Chris</span>! 😎
                    </h1>
                    <p class="text-xl text-slate-600 mb-6 leading-relaxed">
                        Professional Chess Teacher & Youth Chess Coach. With over 30 years of experience teaching chess in elementary schools,
                        libraries, and competitive team environments, I'm one of Central Florida's most trusted and accomplished youth chess
                        instructors.
                    </p>
                    <p class="text-lg text-slate-600 mb-8 leading-relaxed">
                        I bring a rare combination of deep chess knowledge, child-centered teaching skills, and a warm, encouraging presence that
                        helps students thrive both on and off the board. Whether guiding a brand new beginner or sharpening the abilities of a
                        competitive young player, I meet each student exactly where they are and help them grow.
                    </p>

                    <!-- Quick Stats -->
                    <div class="flex flex-wrap gap-4">
                        <div class="bg-white px-6 py-4 rounded-2xl shadow-md border-2 border-yellow-200 text-center">
                            <span class="block text-3xl font-bold text-yellow-600" style="font-family: 'Montserrat', sans-serif;">30+</span>
                            <span class="text-sm text-slate-600 font-medium">Years Teaching</span>
                        </div>
                        <div class="bg-white px-6 py-4 rounded-2xl shadow-md border-2 border-coral-200 text-center">
                            <span class="block text-3xl font-bold text-coral-600" style="font-family: 'Montserrat', sans-serif;">USCF</span>
                            <span class="text-sm text-slate-600 font-medium">Certified TD</span>
                        </div>
                        <div class="bg-white px-6 py-4 rounded-2xl shadow-md border-2 border-purple-200 text-center">
                            <span class="block text-3xl font-bold text-purple-600" style="font-family: 'Montserrat', sans-serif;">K-6</span>
                            <span class="text-sm text-slate-600 font-medium">Grade Levels</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- MY STORY -->
    <section class="py-16 lg:py-24 bg-white">
        <div class="max-w-4xl mx-auto px-4 sm:px-6">
            <div class="text-center mb-12">
                <span
                    class="inline-block bg-coral-100 text-coral-700 px-5 py-2 rounded-full font-bold text-sm mb-4"
                    style="font-family: 'Montserrat', sans-serif;"
                >
                    📖 MY STORY
                </span>
                <h2 class="text-3xl lg:text-5xl font-bold text-slate-800 mb-4" style="font-family: 'Montserrat', sans-serif;">
                    How I Fell in Love with <span class="text-orange-500">Chess</span> ♟️
                </h2>
            </div>

            <div class="space-y-8 text-lg text-slate-600 leading-relaxed">
                <p>
                    My journey with chess spans more than three decades, and it all started with a simple love for the game. Over the years, I've had
                    the privilege of teaching in elementary schools, libraries, and competitive team environments across Central Florida. What began
                    as a passion quickly grew into a lifelong mission: helping young minds discover the power of critical thinking through chess.
                </p>

                <div class="bg-yellow-50 rounded-2xl p-8 border-l-4 border-yellow-400 mt-6 mb-6">
                    <p class="italic text-slate-700 font-medium">
                        "I believe every child has the potential to become a strong thinker. Chess is simply the key that unlocks it."
                    </p>
                    <p class="text-sm text-slate-500 mt-3 font-bold" style="font-family: 'Space Mono', monospace;">
                        — COACH CHRIS, ON HIS TEACHING PHILOSOPHY
                    </p>
                </div>

                <p>
                    As a United States Chess Federation–certified Tournament Director, I've coached numerous private students and school teams at
                    city, state, and national events. My teaching style blends structure with enthusiasm, creating a nurturing environment where
                    children feel confident, focused, and excited to learn.
                </p>

                <p>
                    I'm professionally trained in designing and running elementary school chess programs, and my lessons emphasize critical thinking,
                    sportsmanship, and steady skill development. There's nothing more rewarding than watching a student have that "aha!" moment on the
                    board.
                </p>
            </div>
        </div>
    </section>

    <!-- WHY I TEACH -->
    <section class="py-16 lg:py-24 bg-gradient-to-br from-sky-400 via-purple-500 to-pink-500 relative overflow-hidden">
        <div class="absolute inset-0 opacity-5 text-white whitespace-nowrap select-none overflow-hidden" style="font-size: 12rem; line-height: 1;">
            ♔♕♖♗♘♙♔♕♖♗♘♙
        </div>

        <div class="max-w-5xl mx-auto px-4 sm:px-6 relative z-10">
            <div class="bg-white rounded-[2.5rem] p-8 lg:p-14 shadow-2xl">
                <div class="text-center mb-10">
                    <span
                        class="inline-block bg-purple-100 text-purple-700 px-5 py-2 rounded-full font-bold text-sm mb-4"
                        style="font-family: 'Montserrat', sans-serif;"
                    >
                        ❤️ MY MISSION
                    </span>
                    <h2 class="text-3xl lg:text-5xl font-bold text-slate-800 mb-4" style="font-family: 'Montserrat', sans-serif;">
                        Why I Teach <span class="text-purple-500">Kids</span> Chess
                    </h2>
                </div>

                <div class="grid md:grid-cols-2 gap-8">
                    <div class="space-y-4">
                        <div class="flex items-start gap-4">
                            <div class="w-12 h-12 bg-yellow-400 rounded-2xl flex items-center justify-center text-2xl shadow-md shrink-0">🧠</div>
                            <div>
                                <h3 class="font-bold text-slate-800 text-lg mb-1" style="font-family: 'Montserrat', sans-serif;">
                                    Builds Critical Thinking
                                </h3>
                                <p class="text-slate-600">
                                    Chess teaches children to analyze situations, consider multiple outcomes, and make thoughtful decisions—skills
                                    that transfer directly to the classroom and beyond.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="space-y-4">
                        <div class="flex items-start gap-4">
                            <div class="w-12 h-12 bg-coral-400 rounded-2xl flex items-center justify-center text-2xl shadow-md shrink-0">🤝</div>
                            <div>
                                <h3 class="font-bold text-slate-800 text-lg mb-1" style="font-family: 'Montserrat', sans-serif;">
                                    Teaches Sportsmanship
                                </h3>
                                <p class="text-slate-600">
                                    Win or lose, students learn to shake hands, respect their opponent, and grow from every game. Character matters
                                    just as much as checkmate.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="space-y-4">
                        <div class="flex items-start gap-4">
                            <div class="w-12 h-12 bg-purple-400 rounded-2xl flex items-center justify-center text-2xl shadow-md shrink-0">🎯</div>
                            <div>
                                <h3 class="font-bold text-slate-800 text-lg mb-1" style="font-family: 'Montserrat', sans-serif;">
                                    Boosts Focus & Patience
                                </h3>
                                <p class="text-slate-600">
                                    In a world of instant gratification, chess rewards careful planning and concentration. Students develop the
                                    patience to think before they act.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="space-y-4">
                        <div class="flex items-start gap-4">
                            <div class="w-12 h-12 bg-green-400 rounded-2xl flex items-center justify-center text-2xl shadow-md shrink-0">🏆</div>
                            <div>
                                <h3 class="font-bold text-slate-800 text-lg mb-1" style="font-family: 'Montserrat', sans-serif;">
                                    Builds Confidence
                                </h3>
                                <p class="text-slate-600">
                                    Every puzzle solved and game won builds self-esteem. Students carry that confidence into academics, friendships,
                                    and every challenge they face.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CURRENT TEACHING ROLES -->
    <section class="py-16 lg:py-24 bg-yellow-50">
        <div class="max-w-5xl mx-auto px-4 sm:px-6">
            <div class="text-center mb-12">
                <span
                    class="inline-block bg-orange-100 text-orange-700 px-5 py-2 rounded-full font-bold text-sm mb-4"
                    style="font-family: 'Montserrat', sans-serif;"
                >
                    🏫 CURRENT ROLES
                </span>
                <h2 class="text-3xl lg:text-5xl font-bold text-slate-800 mb-4" style="font-family: 'Montserrat', sans-serif;">
                    Where I <span class="text-orange-500">Teach</span>
                </h2>
            </div>

            <div class="space-y-6">
                <div class="bg-white rounded-2xl p-6 lg:p-8 shadow-md border-l-4 border-yellow-400 flex items-start gap-6">
                    <div class="w-14 h-14 bg-yellow-100 rounded-2xl flex items-center justify-center text-3xl shrink-0">🏫</div>
                    <div>
                        <h3 class="font-bold text-slate-800 text-xl mb-1" style="font-family: 'Montserrat', sans-serif;">
                            Holy Family Catholic School
                        </h3>
                        <p class="text-slate-500 text-sm font-medium mb-2">Orlando, FL • 2025–Present</p>
                        <p class="text-slate-600">
                            After-school chess coach for grades K–6, helping young students build foundational skills in a supportive Catholic school
                            environment.
                        </p>
                    </div>
                </div>

                <div class="bg-white rounded-2xl p-6 lg:p-8 shadow-md border-l-4 border-coral-400 flex items-start gap-6">
                    <div class="w-14 h-14 bg-coral-100 rounded-2xl flex items-center justify-center text-3xl shrink-0">📚</div>
                    <div>
                        <h3 class="font-bold text-slate-800 text-xl mb-1" style="font-family: 'Montserrat', sans-serif;">
                            Choices In Learning Charter School
                        </h3>
                        <p class="text-slate-500 text-sm font-medium mb-2">Winter Springs, FL • 2024–Present</p>
                        <p class="text-slate-600">
                            After-school chess coach for grades K–6, fostering critical thinking and competitive spirit in a charter school setting.
                        </p>
                    </div>
                </div>

                <div class="bg-white rounded-2xl p-6 lg:p-8 shadow-md border-l-4 border-purple-400 flex items-start gap-6">
                    <div class="w-14 h-14 bg-purple-100 rounded-2xl flex items-center justify-center text-3xl shrink-0">🌞</div>
                    <div>
                        <h3 class="font-bold text-slate-800 text-xl mb-1" style="font-family: 'Montserrat', sans-serif;">
                            Seminole County Public Library System
                        </h3>
                        <p class="text-slate-500 text-sm font-medium mb-2">2023–Present</p>
                        <p class="text-slate-600">
                            Lead chess instructor for summer programs, introducing chess to community youth through engaging library-based workshops
                            and camps.
                        </p>
                    </div>
                </div>

                <div class="bg-white rounded-2xl p-6 lg:p-8 shadow-md border-l-4 border-green-400 flex items-start gap-6">
                    <div class="w-14 h-14 bg-green-100 rounded-2xl flex items-center justify-center text-3xl shrink-0">✝️</div>
                    <div>
                        <h3 class="font-bold text-slate-800 text-xl mb-1" style="font-family: 'Montserrat', sans-serif;">St. Mary Magdalen</h3>
                        <p class="text-slate-500 text-sm font-medium mb-2">Altamonte Springs, FL • 2023–Present</p>
                        <p class="text-slate-600">
                            After-school chess coach for grades K–6, combining faith-based values with strategic thinking development.
                        </p>
                    </div>
                </div>

                <div class="bg-white rounded-2xl p-6 lg:p-8 shadow-md border-l-4 border-sky-400 flex items-start gap-6">
                    <div class="w-14 h-14 bg-sky-100 rounded-2xl flex items-center justify-center text-3xl shrink-0">⭐</div>
                    <div>
                        <h3 class="font-bold text-slate-800 text-xl mb-1" style="font-family: 'Montserrat', sans-serif;">
                            Annunciation Catholic Academy
                        </h3>
                        <p class="text-slate-500 text-sm font-medium mb-2">Altamonte Springs, FL • 2023–Present</p>
                        <p class="text-slate-600">
                            After-school chess coach for grades K–6, nurturing both competitive skills and character development in a Catholic academy
                            environment.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- WHY FAMILIES CHOOSE ME -->
    <section class="py-16 lg:py-24 bg-white">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
            <span
                class="inline-block bg-sky-100 text-sky-700 px-5 py-2 rounded-full font-bold text-sm mb-4"
                style="font-family: 'Montserrat', sans-serif;"
            >
                💪 WHY FAMILIES CHOOSE ME
            </span>
            <h2 class="text-3xl lg:text-5xl font-bold text-slate-800 mb-6" style="font-family: 'Montserrat', sans-serif;">
                Trusted by <span class="text-sky-500">Central Florida</span> Families
            </h2>

            <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem;">
                <div
                    class="bg-gradient-to-br from-yellow-50 to-orange-50 rounded-3xl p-8 border-4 border-yellow-200 text-center hover:shadow-lg transition-shadow"
                >
                    <span class="text-5xl block mb-3">📅</span>
                    <h3 class="font-bold text-slate-800 text-lg mb-2">30+ Years Experience</h3>
                    <p class="text-slate-600">Three decades of hands-on teaching in schools, libraries, and competitive environments.</p>
                </div>

                <div
                    class="bg-gradient-to-br from-coral-50 to-pink-50 rounded-3xl p-8 border-4 border-coral-200 text-center hover:shadow-lg transition-shadow"
                >
                    <span class="text-5xl block mb-3">🏅</span>
                    <h3 class="font-bold text-slate-800 text-lg mb-2">USCF Certified</h3>
                    <p class="text-slate-600">
                        Certified United States Chess Federation Tournament Director with proven competitive coaching success.
                    </p>
                </div>

                <div
                    class="bg-gradient-to-br from-purple-50 to-indigo-50 rounded-3xl p-8 border-4 border-purple-200 text-center hover:shadow-lg transition-shadow"
                >
                    <span class="text-5xl block mb-3">🤗</span>
                    <h3 class="font-bold text-slate-800 text-lg mb-2">Child-Centered Approach</h3>
                    <p class="text-slate-600">Expert at creating supportive, engaging learning environments where every child feels valued.</p>
                </div>

                <div
                    class="bg-gradient-to-br from-green-50 to-teal-50 rounded-3xl p-8 border-4 border-green-200 text-center hover:shadow-lg transition-shadow"
                >
                    <span class="text-5xl block mb-3">💬</span>
                    <h3 class="font-bold text-slate-800 text-lg mb-2">Strong Communication</h3>
                    <p class="text-slate-600">Clear, open communication with both children and parents to support every student's growth.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- CONTACT / CTA -->
    <section class="py-16 lg:py-24 bg-gradient-to-r from-orange-400 via-coral-500 to-purple-500">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
            <h2 class="text-3xl lg:text-5xl font-bold text-white mb-6" style="font-family: 'Montserrat', sans-serif;">
                Ready to Start Your Chess Journey? 🚀
            </h2>
            <p class="text-xl text-white/90 mb-8 max-w-2xl mx-auto">
                Join hundreds of Central Florida kids already having fun and building skills! Your first move starts here.
            </p>

            <div class="flex flex-wrap gap-4 justify-center mb-10">
                <a
                    href="/register"
                    class="bg-white text-coral-500 px-10 py-5 rounded-full text-xl font-bold shadow-xl hover:shadow-2xl hover:scale-105 transition-all inline-flex items-center gap-2"
                    style="font-family: 'Montserrat', sans-serif;"
                >
                    Register Now! 🚀
                </a>
                <a
                    href="/lessons"
                    class="bg-transparent text-white px-10 py-5 rounded-full text-xl font-bold border-4 border-white hover:bg-white/10 transition-all inline-flex items-center gap-2"
                    style="font-family: 'Montserrat', sans-serif;"
                >
                    See All Lessons 📚
                </a>
            </div>

            <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-6 inline-block">
                <p class="text-white/90 text-lg mb-2">📞 <a href="tel:917-981-1564" class="font-bold hover:underline">917-981-1564</a></p>
                <p class="text-white/90 text-lg">
                    ✉️ <a href="mailto:metrochess@gmail.com" class="font-bold hover:underline">metrochess@gmail.com</a>
                </p>
            </div>
        </div>
    </section>
</Layout>
