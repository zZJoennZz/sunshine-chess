---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact | Sunshine Chess - Get in Touch!">
    <!-- PAGE HERO -->
    <section class="relative bg-gradient-to-br from-yellow-100 via-orange-50 to-coral-50 py-16 lg:py-24 overflow-hidden">
        <div class="absolute top-20 left-10 w-32 h-32 bg-yellow-300 rounded-full opacity-40 blur-2xl animate-pulse"></div>
        <div class="absolute bottom-20 right-10 w-40 h-40 bg-coral-300 rounded-full opacity-30 blur-3xl animate-pulse" style="animation-delay: 1s;">
        </div>

        <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center relative z-10">
            <div
                class="inline-flex items-center gap-2 bg-white px-5 py-3 rounded-full shadow-lg border-4 border-yellow-400 mb-6 transform hover:scale-105 transition-transform"
            >
                <span class="text-xl">📬</span>
                <span class="font-bold text-slate-800 text-lg" style="font-family: 'Montserrat', sans-serif;">Let's Chat!</span>
            </div>

            <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-slate-800 leading-tight mb-4" style="font-family: 'Montserrat', sans-serif;">
                Get in Touch with <span class="text-orange-500">Coach Chris</span>! 👋
            </h1>

            <p class="text-lg text-slate-600 max-w-2xl mx-auto">
                Questions about classes, schedules, or the Step Up program? I'd love to hear from you! 🌟
            </p>
        </div>
    </section>

    <!-- CONTACT INFO CARDS -->
    <section class="py-12 lg:py-16 bg-white">
        <div class="max-w-5xl mx-auto px-4 sm:px-6">
            <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem;">
                <!-- Email -->
                <div
                    class="bg-gradient-to-br from-yellow-50 to-orange-50 rounded-3xl p-8 border-4 border-yellow-200 text-center hover:shadow-lg transition-shadow"
                >
                    <div class="w-16 h-16 bg-yellow-400 rounded-full flex items-center justify-center text-3xl mx-auto mb-4 shadow-lg">📧</div>
                    <h3 class="font-bold text-slate-800 text-xl mb-2" style="font-family: 'Montserrat', sans-serif;">Email Me</h3>
                    <p class="text-slate-600 mb-3">For questions about classes, scheduling, or anything else!</p>
                    <a href="mailto:chris@sunshinechess.com" class="text-orange-500 font-bold hover:text-orange-600 transition-colors text-lg">
                        chris@sunshinechess.com
                    </a>
                </div>

                <!-- Phone -->
                <div
                    class="bg-gradient-to-br from-coral-50 to-pink-50 rounded-3xl p-8 border-4 border-coral-200 text-center hover:shadow-lg transition-shadow"
                >
                    <div class="w-16 h-16 bg-coral-400 rounded-full flex items-center justify-center text-3xl mx-auto mb-4 shadow-lg">📞</div>
                    <h3 class="font-bold text-slate-800 text-xl mb-2" style="font-family: 'Montserrat', sans-serif;">Call or Text</h3>
                    <p class="text-slate-600 mb-3">Available Monday–Saturday, 9am–6pm EST</p>
                    <a
                        href="tel:3055552437"
                        class="text-coral-500 font-bold hover:text-coral-600 transition-colors text-lg"
                        style="font-family: 'Space Mono', monospace;"
                    >
                        (305) 555-CHESS
                    </a>
                </div>

                <!-- Location -->
                <div
                    class="bg-gradient-to-br from-purple-50 to-indigo-50 rounded-3xl p-8 border-4 border-purple-200 text-center hover:shadow-lg transition-shadow"
                >
                    <div class="w-16 h-16 bg-purple-400 rounded-full flex items-center justify-center text-3xl mx-auto mb-4 shadow-lg">🌴</div>
                    <h3 class="font-bold text-slate-800 text-xl mb-2" style="font-family: 'Montserrat', sans-serif;">Teaching Across Florida</h3>
                    <p class="text-slate-600 mb-3">Miami • Fort Lauderdale • Boca Raton • Orlando • Tampa • Jacksonville</p>
                    <span class="text-purple-500 font-bold text-sm" style="font-family: 'Space Mono', monospace;">AND MORE!</span>
                </div>

                <!-- Social -->
                <div
                    class="bg-gradient-to-br from-sky-50 to-teal-50 rounded-3xl p-8 border-4 border-sky-200 text-center hover:shadow-lg transition-shadow"
                >
                    <div class="w-16 h-16 bg-sky-400 rounded-full flex items-center justify-center text-3xl mx-auto mb-4 shadow-lg">🌐</div>
                    <h3 class="font-bold text-slate-800 text-xl mb-2" style="font-family: 'Montserrat', sans-serif;">Follow Along</h3>
                    <p class="text-slate-600 mb-4">Stay updated on tournaments, new classes, and chess tips!</p>
                    <div class="flex justify-center gap-3">
                        <a href="#" class="bg-sky-400 text-white px-4 py-2 rounded-full font-bold hover:bg-sky-500 transition-colors text-sm">
                            Facebook
                        </a>
                        <a href="#" class="bg-pink-400 text-white px-4 py-2 rounded-full font-bold hover:bg-pink-500 transition-colors text-sm">
                            Instagram
                        </a>
                        <a href="#" class="bg-red-500 text-white px-4 py-2 rounded-full font-bold hover:bg-red-600 transition-colors text-sm">
                            YouTube
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CONTACT FORM SECTION -->
    <section class="py-16 lg:py-24 bg-yellow-50">
        <div class="max-w-4xl mx-auto px-4 sm:px-6">
            <div class="text-center mb-6">
                <span
                    class="inline-block bg-orange-400 text-white px-6 py-2 rounded-full font-bold text-sm mb-4"
                    style="font-family: 'Montserrat', sans-serif;"
                >
                    ✏️ SEND A MESSAGE
                </span>
                <h2 class="text-3xl lg:text-5xl font-bold text-slate-800 mb-4" style="font-family: 'Montserrat', sans-serif;">
                    Drop Me a Line! <span class="text-orange-500">📨</span>
                </h2>
                <p class="text-lg text-slate-600 max-w-2xl mx-auto">Fill out the form below and I'll get back to you within 24 hours. Promise! 🤝</p>
            </div>

            <!-- Google Form -->
            <div class="bg-white rounded-[2.5rem] shadow-2xl p-4 lg:p-8 border-4 border-yellow-200">
                <div class="bg-slate-50 rounded-[2rem] overflow-hidden relative">[FORM HERE]</div>
            </div>

            <div class="mt-8 text-center">
                <p class="text-slate-500 mb-2">Prefer to reach out directly?</p>
                <div class="flex flex-wrap gap-4 justify-center">
                    <a
                        href="mailto:chris@sunshinechess.com"
                        class="inline-flex items-center gap-2 text-orange-500 font-bold hover:text-orange-600 transition-colors"
                    >
                        📧 Email Me
                    </a>
                    <span class="text-slate-300">|</span>
                    <a
                        href="tel:3055552437"
                        class="inline-flex items-center gap-2 text-coral-500 font-bold hover:text-coral-600 transition-colors"
                        style="font-family: 'Space Mono', monospace;"
                    >
                        📞 (305) 555-CHESS
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ TEASER -->
    <section class="py-16 lg:py-24 bg-white">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
            <h2 class="text-3xl lg:text-4xl font-bold text-slate-800 mb-6" style="font-family: 'Montserrat', sans-serif;">
                Got Questions? <span class="text-purple-500">Check the FAQ!</span> ❓
            </h2>
            <p class="text-lg text-slate-600 mb-8 max-w-2xl mx-auto">
                Ive answered some of the most common questions about classes, pricing, and the Step Up program.
            </p>
            <a
                href="/faq"
                class="bg-purple-500 hover:bg-purple-600 text-white px-10 py-4 rounded-full font-bold shadow-lg hover:shadow-xl hover:scale-105 transition-all inline-flex items-center gap-2 text-lg"
                style="font-family: 'Montserrat', sans-serif;"
            >
                View FAQ 📚
            </a>
        </div>
    </section>

    <!-- CTA -->
    <section class="py-16 lg:py-24 bg-gradient-to-r from-orange-400 via-coral-500 to-purple-500">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
            <h2 class="text-3xl lg:text-5xl font-bold text-white mb-6" style="font-family: 'Montserrat', sans-serif;">
                Ready to Start Your Chess Journey? 🚀
            </h2>
            <p class="text-xl text-white/90 mb-8 max-w-2xl mx-auto">Dont wait! Spots fill up fast. Register now and secure your place in class.</p>

            <div class="flex flex-wrap gap-4 justify-center">
                <a
                    href="/register"
                    class="bg-white text-coral-500 px-10 py-5 rounded-full text-xl font-bold shadow-xl hover:shadow-2xl hover:scale-105 transition-all inline-flex items-center gap-2"
                    style="font-family: 'Montserrat', sans-serif;"
                >
                    Register Now! 📝
                </a>
                <a
                    href="/lessons"
                    class="bg-transparent text-white px-10 py-5 rounded-full text-xl font-bold border-4 border-white hover:bg-white/10 transition-all inline-flex items-center gap-2"
                    style="font-family: 'Montserrat', sans-serif;"
                >
                    See Classes 📖
                </a>
            </div>
        </div>
    </section>
</Layout>
