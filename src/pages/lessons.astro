---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Sunshine Chess | Chess Classes for Kids in Florida 📚">
    <!-- HERO SECTION -->
    <section class="relative bg-gradient-to-br from-yellow-100 via-orange-50 to-coral-50 py-16 lg:py-24 overflow-hidden">
        <!-- Fun Background Blobs -->
        <div class="absolute top-20 left-10 w-32 h-32 bg-yellow-300 rounded-full opacity-40 blur-2xl animate-pulse"></div>
        <div class="absolute bottom-20 right-10 w-40 h-40 bg-coral-300 rounded-full opacity-30 blur-3xl animate-pulse" style="animation-delay: 1s;">
        </div>
        <div class="absolute top-1/2 left-1/4 w-24 h-24 bg-purple-300 rounded-full opacity-20 blur-xl animate-pulse" style="animation-delay: 2s;">
        </div>

        <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10">
            <div class="text-center max-w-3xl mx-auto">
                <div
                    class="inline-flex items-center gap-2 bg-white px-5 py-3 rounded-full shadow-lg border-3 border-yellow-400 mb-6 transform hover:scale-105 transition-transform"
                >
                    <span class="text-xl">📚</span>
                    <span class="font-bold text-slate-800 text-sm lg:text-base">Pick Your Perfect Class!</span>
                </div>

                <h1
                    class="text-4xl md:text-5xl lg:text-6xl font-bold text-slate-800 leading-tight mb-6"
                    style="font-family: 'Montserrat', sans-serif;"
                >
                    Chess Classes Made
                    <span class="relative inline-block">
                        <span class="text-orange-500">Fun</span>
                        <span class="absolute -bottom-2 left-0 w-full h-4 bg-yellow-300 rounded-full -z-10 opacity-60"></span>
                    </span>
                    ! 🎮
                </h1>

                <p class="text-lg lg:text-xl text-slate-600 mb-8 max-w-2xl mx-auto leading-relaxed">
                    From your very first move to tournament champion — <strong class="text-orange-500">Coach Chris</strong> has the perfect class for every
                    skill level! 🏆
                </p>

                <div class="flex flex-wrap gap-4 justify-center">
                    <a href="/register" class="btn-fun text-white px-8 py-4 text-lg font-bold inline-flex items-center gap-2">Register Now! 🚀</a>
                    <a
                        href="/faq"
                        class="bg-white text-slate-700 px-8 py-4 rounded-full text-lg font-bold border-4 border-yellow-300 hover:bg-yellow-50 hover:border-yellow-400 transition-all inline-flex items-center gap-2 shadow-lg"
                    >
                        Have Questions? ❓
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- CLASS CARDS SECTION -->
    <section class="py-16 lg:py-24 bg-white">
        <div class="max-w-6xl mx-auto px-4 sm:px-6">
            <div class="text-center mb-12">
                <span class="inline-block bg-yellow-300 text-slate-800 px-6 py-2 rounded-full font-bold text-sm mb-4">🎯 Choose Your Level</span>
                <h2 class="text-3xl lg:text-5xl font-bold text-slate-800 mb-4" style="font-family: 'Montserrat', sans-serif;">
                    Find Your <span class="text-orange-500">Perfect</span> Class! 🌟
                </h2>
                <p class="text-lg text-slate-600 max-w-2xl mx-auto">
                    Three amazing levels designed to take your child from beginner moves to championship wins!
                </p>
            </div>

            <div class="grid md:grid-cols-3 gap-8">
                <!-- Beginners -->
                <div
                    class="card-fun overflow-hidden bg-gradient-to-b from-white to-yellow-50 border-4 border-yellow-200 hover:border-yellow-400 transition-all"
                >
                    <div class="h-56 bg-gradient-to-br from-yellow-300 to-orange-400 relative overflow-hidden">
                        <div class="absolute inset-0 flex items-center justify-center">
                            <div class="text-center">
                                <span class="text-7xl">🌱</span>
                                <p class="text-white font-bold mt-2 text-lg">Beginners</p>
                            </div>
                        </div>
                        <div class="absolute top-4 right-4 bg-white px-4 py-2 rounded-full text-sm font-bold text-slate-800 shadow-lg">Ages 5-12</div>
                        <div class="absolute bottom-4 left-4 bg-yellow-500 text-white px-3 py-1 rounded-full text-xs font-bold">Most Popular! ⭐</div>
                    </div>
                    <div class="p-6">
                        <h3 class="text-2xl font-bold text-slate-800 mb-2" style="font-family: 'Montserrat', sans-serif;">Beginners 🌱</h3>
                        <p class="text-slate-600 mb-4">Learn how pieces move, play your first game, and make new friends!</p>

                        <div class="space-y-3 mb-6">
                            <div class="flex items-start gap-3">
                                <span class="w-6 h-6 bg-green-400 rounded-full flex items-center justify-center text-white text-xs shrink-0 mt-0.5">
                                    ✓
                                </span>
                                <span class="text-slate-700 text-sm">Fun piece characters & stories to remember moves</span>
                            </div>
                            <div class="flex items-start gap-3">
                                <span class="w-6 h-6 bg-green-400 rounded-full flex items-center justify-center text-white text-xs shrink-0 mt-0.5">
                                    ✓
                                </span>
                                <span class="text-slate-700 text-sm">Chess puzzles & mini-games every class</span>
                            </div>
                            <div class="flex items-start gap-3">
                                <span class="w-6 h-6 bg-green-400 rounded-full flex items-center justify-center text-white text-xs shrink-0 mt-0.5">
                                    ✓
                                </span>
                                <span class="text-slate-700 text-sm">Learn to play a complete game by Week 4!</span>
                            </div>
                            <div class="flex items-start gap-3">
                                <span class="w-6 h-6 bg-green-400 rounded-full flex items-center justify-center text-white text-xs shrink-0 mt-0.5">
                                    ✓
                                </span>
                                <span class="text-slate-700 text-sm">First tournament ready by the end!</span>
                            </div>
                        </div>

                        <div class="bg-yellow-100 rounded-xl p-4 mb-6">
                            <p class="text-xs text-slate-600 font-bold mb-1">📅 Schedule Options:</p>
                            <p class="text-sm text-slate-700">• Once weekly (60 min)</p>
                            <p class="text-sm text-slate-700">• Summer camp (week-long)</p>
                        </div>

                        <!-- <div class="flex items-center justify-between pt-4 border-t-2 border-dashed border-yellow-300">
                            <div>
                                <span class="text-3xl font-bold text-slate-800">$45</span>
                                <span class="text-slate-500 text-sm">/class</span>
                            </div>
                            <a
                                href="/register?level=beginner"
                                class="bg-yellow-400 hover:bg-yellow-500 text-slate-800 px-6 py-3 rounded-full font-bold transition-colors shadow-lg"
                            >
                                Join! 🚀
                            </a>
                        </div> -->
                    </div>
                </div>

                <!-- Intermediate -->
                <div
                    class="card-fun overflow-hidden bg-gradient-to-b from-white to-coral-50 border-4 border-coral-200 hover:border-coral-400 transition-all"
                >
                    <div class="h-56 bg-gradient-to-br from-coral-400 to-pink-500 relative overflow-hidden">
                        <div class="absolute inset-0 flex items-center justify-center">
                            <div class="text-center">
                                <span class="text-7xl">⚡</span>
                                <p class="text-white font-bold mt-2 text-lg">Intermediate</p>
                            </div>
                        </div>
                        <div class="absolute top-4 right-4 bg-white px-4 py-2 rounded-full text-sm font-bold text-slate-800 shadow-lg">Ages 8-14</div>
                    </div>
                    <div class="p-6">
                        <h3 class="text-2xl font-bold text-slate-800 mb-2" style="font-family: 'Montserrat', sans-serif;">Intermediate ⚡</h3>
                        <p class="text-slate-600 mb-4">Master tactics, learn cool openings, and crush the competition!</p>

                        <div class="space-y-3 mb-6">
                            <div class="flex items-start gap-3">
                                <span class="w-6 h-6 bg-coral-400 rounded-full flex items-center justify-center text-white text-xs shrink-0 mt-0.5">
                                    ✓
                                </span>
                                <span class="text-slate-700 text-sm">Sneaky tactics, forks, pins & discovered attacks</span>
                            </div>
                            <div class="flex items-start gap-3">
                                <span class="w-6 h-6 bg-coral-400 rounded-full flex items-center justify-center text-white text-xs shrink-0 mt-0.5">
                                    ✓
                                </span>
                                <span class="text-slate-700 text-sm">Opening superpowers — build your repertoire</span>
                            </div>
                            <div class="flex items-start gap-3">
                                <span class="w-6 h-6 bg-coral-400 rounded-full flex items-center justify-center text-white text-xs shrink-0 mt-0.5">
                                    ✓
                                </span>
                                <span class="text-slate-700 text-sm">Rated tournament play & USCF membership</span>
                            </div>
                            <div class="flex items-start gap-3">
                                <span class="w-6 h-6 bg-coral-400 rounded-full flex items-center justify-center text-white text-xs shrink-0 mt-0.5">
                                    ✓
                                </span>
                                <span class="text-slate-700 text-sm">Game analysis with Coach Chris</span>
                            </div>
                        </div>

                        <div class="bg-coral-100 rounded-xl p-4 mb-6">
                            <p class="text-xs text-slate-600 font-bold mb-1">📅 Schedule Options:</p>
                            <p class="text-sm text-slate-700">• Once or twice weekly (60 min)</p>
                            <p class="text-sm text-slate-700">• Tournament prep sessions</p>
                        </div>

                        <!-- <div class="flex items-center justify-between pt-4 border-t-2 border-dashed border-coral-300">
                            <div>
                                <span class="text-3xl font-bold text-slate-800">$55</span>
                                <span class="text-slate-500 text-sm">/class</span>
                            </div>
                            <a
                                href="/register?level=intermediate"
                                class="bg-coral-400 hover:bg-coral-500 text-white px-6 py-3 rounded-full font-bold transition-colors shadow-lg"
                            >
                                Level Up! 🎮
                            </a>
                        </div> -->
                    </div>
                </div>

                <!-- Advanced -->
                <div
                    class="card-fun overflow-hidden bg-gradient-to-b from-white to-purple-50 border-4 border-purple-200 hover:border-purple-400 transition-all"
                >
                    <div class="h-56 bg-gradient-to-br from-purple-500 to-indigo-600 relative overflow-hidden">
                        <div class="absolute inset-0 flex items-center justify-center">
                            <div class="text-center">
                                <span class="text-7xl">👑</span>
                                <p class="text-white font-bold mt-2 text-lg">Advanced</p>
                            </div>
                        </div>
                        <div class="absolute top-4 right-4 bg-white px-4 py-2 rounded-full text-sm font-bold text-slate-800 shadow-lg">
                            Ages 10-16
                        </div>
                        <div class="absolute bottom-4 left-4 bg-purple-500 text-white px-3 py-1 rounded-full text-xs font-bold">
                            Champions Only! 🏆
                        </div>
                    </div>
                    <div class="p-6">
                        <h3 class="text-2xl font-bold text-slate-800 mb-2" style="font-family: 'Montserrat', sans-serif;">Advanced 👑</h3>
                        <p class="text-slate-600 mb-4">Become a chess master! Deep strategy, endgame magic, and championship prep.</p>

                        <div class="space-y-3 mb-6">
                            <div class="flex items-start gap-3">
                                <span class="w-6 h-6 bg-purple-500 rounded-full flex items-center justify-center text-white text-xs shrink-0 mt-0.5">
                                    ✓
                                </span>
                                <span class="text-slate-700 text-sm">Grandmaster strategies & positional play</span>
                            </div>
                            <div class="flex items-start gap-3">
                                <span class="w-6 h-6 bg-purple-500 rounded-full flex items-center justify-center text-white text-xs shrink-0 mt-0.5">
                                    ✓
                                </span>
                                <span class="text-slate-700 text-sm">Endgame wizardry — win every rook ending!</span>
                            </div>
                            <div class="flex items-start gap-3">
                                <span class="w-6 h-6 bg-purple-500 rounded-full flex items-center justify-center text-white text-xs shrink-0 mt-0.5">
                                    ✓
                                </span>
                                <span class="text-slate-700 text-sm">State & national championship preparation</span>
                            </div>
                            <div class="flex items-start gap-3">
                                <span class="w-6 h-6 bg-purple-500 rounded-full flex items-center justify-center text-white text-xs shrink-0 mt-0.5">
                                    ✓
                                </span>
                                <span class="text-slate-700 text-sm">One-on-one game review & coaching</span>
                            </div>
                        </div>

                        <div class="bg-purple-100 rounded-xl p-4 mb-6">
                            <p class="text-xs text-slate-600 font-bold mb-1">📅 Schedule Options:</p>
                            <p class="text-sm text-slate-700">• Twice weekly (60-90 min)</p>
                            <p class="text-sm text-slate-700">• Private coaching available</p>
                        </div>

                        <!-- <div class="flex items-center justify-between pt-4 border-t-2 border-dashed border-purple-300">
                            <div>
                                <span class="text-3xl font-bold text-slate-800">$65</span>
                                <span class="text-slate-500 text-sm">/class</span>
                            </div>
                            <a
                                href="/register?level=advanced"
                                class="bg-purple-500 hover:bg-purple-600 text-white px-6 py-3 rounded-full font-bold transition-colors shadow-lg"
                            >
                                Go Pro! 🏆
                            </a>
                        </div> -->
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- WHAT'S INCLUDED SECTION -->
    <section class="py-16 lg:py-24 bg-gradient-to-br from-sky-50 to-teal-50">
        <div class="max-w-6xl mx-auto px-4 sm:px-6">
            <div class="text-center mb-12">
                <span class="inline-block bg-sky-400 text-white px-6 py-2 rounded-full font-bold text-sm mb-4">✨ Every Class Includes</span>
                <h2 class="text-3xl lg:text-5xl font-bold text-slate-800 mb-4" style="font-family: 'Montserrat', sans-serif;">
                    What You <span class="text-sky-500">Get</span> With Every Class! 🎁
                </h2>
            </div>

            <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
                <div
                    class="bg-white rounded-2xl p-6 text-center shadow-lg border-2 border-yellow-200 hover:border-yellow-400 transition-all hover:-translate-y-1"
                >
                    <div class="w-16 h-16 bg-yellow-400 rounded-full flex items-center justify-center text-3xl mx-auto mb-4 shadow-lg">👨‍🏫</div>
                    <h3 class="font-bold text-lg text-slate-800 mb-2">Expert Coaching</h3>
                    <p class="text-slate-600 text-sm">15+ years experience from Coach Chris with a 2200 rating!</p>
                </div>

                <div
                    class="bg-white rounded-2xl p-6 text-center shadow-lg border-2 border-coral-200 hover:border-coral-400 transition-all hover:-translate-y-1"
                >
                    <div class="w-16 h-16 bg-coral-400 rounded-full flex items-center justify-center text-3xl mx-auto mb-4 shadow-lg">📖</div>
                    <h3 class="font-bold text-lg text-slate-800 mb-2">Learning Materials</h3>
                    <p class="text-slate-600 text-sm">Workbooks, puzzles, and digital resources included!</p>
                </div>

                <div
                    class="bg-white rounded-2xl p-6 text-center shadow-lg border-2 border-purple-200 hover:border-purple-400 transition-all hover:-translate-y-1"
                >
                    <div class="w-16 h-16 bg-purple-500 rounded-full flex items-center justify-center text-3xl mx-auto mb-4 shadow-lg">🏆</div>
                    <h3 class="font-bold text-lg text-slate-800 mb-2">Tournament Access</h3>
                    <p class="text-slate-600 text-sm">Entry to Sunshine Chess in-house tournaments all year!</p>
                </div>

                <div
                    class="bg-white rounded-2xl p-6 text-center shadow-lg border-2 border-sky-200 hover:border-sky-400 transition-all hover:-translate-y-1"
                >
                    <div class="w-16 h-16 bg-sky-400 rounded-full flex items-center justify-center text-3xl mx-auto mb-4 shadow-lg">📊</div>
                    <h3 class="font-bold text-lg text-slate-800 mb-2">Progress Tracking</h3>
                    <p class="text-slate-600 text-sm">Regular skill assessments and parent updates!</p>
                </div>
            </div>
        </div>
    </section>

    <!-- CLASS FORMATS SECTION -->
    <section class="py-16 lg:py-24 bg-white">
        <div class="max-w-6xl mx-auto px-4 sm:px-6">
            <div class="text-center mb-12">
                <span class="inline-block bg-orange-400 text-white px-6 py-2 rounded-full font-bold text-sm mb-4">🗓️ Flexible Options</span>
                <h2 class="text-3xl lg:text-5xl font-bold text-slate-800 mb-4" style="font-family: 'Montserrat', sans-serif;">
                    Choose Your <span class="text-orange-500">Format</span>! 🎯
                </h2>
                <p class="text-lg text-slate-600 max-w-2xl mx-auto">In-person, online, or private — we have the perfect setup for your family!</p>
            </div>

            <div class="grid md:grid-cols-3 gap-8">
                <!-- In-Person -->
                <div class="card-fun bg-gradient-to-b from-yellow-50 to-orange-50 border-4 border-yellow-300 p-8 text-center">
                    <div class="w-20 h-20 bg-yellow-400 rounded-full flex items-center justify-center text-4xl mx-auto mb-4 shadow-lg">🏫</div>
                    <h3 class="text-2xl font-bold text-slate-800 mb-2" style="font-family: 'Montserrat', sans-serif;">In-Person</h3>
                    <p class="text-slate-600 mb-4">Learn face-to-face with Coach Chris and make friends in class!</p>
                    <ul class="text-left space-y-2 mb-6 text-sm">
                        <li class="flex items-center gap-2 text-slate-700">
                            <span class="text-yellow-500">✓</span> Small groups (4-12 kids)
                        </li>
                        <li class="flex items-center gap-2 text-slate-700">
                            <span class="text-yellow-500">✓</span> Physical chess sets provided
                        </li>
                        <li class="flex items-center gap-2 text-slate-700">
                            <span class="text-yellow-500">✓</span> All across Florida
                        </li>
                        <li class="flex items-center gap-2 text-slate-700">
                            <span class="text-yellow-500">✓</span> Social & interactive
                        </li>
                    </ul>
                    <span class="inline-block bg-yellow-400 text-slate-800 px-4 py-2 rounded-full font-bold text-sm">Most Fun! 🎉</span>
                </div>

                <!-- Online -->
                <div class="card-fun bg-gradient-to-b from-sky-50 to-teal-50 border-4 border-sky-300 p-8 text-center">
                    <div class="w-20 h-20 bg-sky-400 rounded-full flex items-center justify-center text-4xl mx-auto mb-4 shadow-lg">💻</div>
                    <h3 class="text-2xl font-bold text-slate-800 mb-2" style="font-family: 'Montserrat', sans-serif;">Online</h3>
                    <p class="text-slate-600 mb-4">Live Zoom classes from the comfort of home — anywhere in Florida!</p>
                    <ul class="text-left space-y-2 mb-6 text-sm">
                        <li class="flex items-center gap-2 text-slate-700">
                            <span class="text-sky-500">✓</span> Small groups (max 8 kids)
                        </li>
                        <li class="flex items-center gap-2 text-slate-700">
                            <span class="text-sky-500">✓</span> Interactive digital boards
                        </li>
                        <li class="flex items-center gap-2 text-slate-700">
                            <span class="text-sky-500">✓</span> Flexible scheduling
                        </li>
                        <li class="flex items-center gap-2 text-slate-700">
                            <span class="text-sky-500">✓</span> No commute needed!
                        </li>
                    </ul>
                    <span class="inline-block bg-sky-400 text-white px-4 py-2 rounded-full font-bold text-sm">Super Convenient! ⚡</span>
                </div>

                <!-- Private -->
                <div class="card-fun bg-gradient-to-b from-purple-50 to-indigo-50 border-4 border-purple-300 p-8 text-center">
                    <div class="w-20 h-20 bg-purple-500 rounded-full flex items-center justify-center text-4xl mx-auto mb-4 shadow-lg">🎯</div>
                    <h3 class="text-2xl font-bold text-slate-800 mb-2" style="font-family: 'Montserrat', sans-serif;">Private</h3>
                    <p class="text-slate-600 mb-4">One-on-one coaching tailored to your child's specific needs!</p>
                    <ul class="text-left space-y-2 mb-6 text-sm">
                        <li class="flex items-center gap-2 text-slate-700">
                            <span class="text-purple-500">✓</span> Fully personalized lessons
                        </li>
                        <li class="flex items-center gap-2 text-slate-700">
                            <span class="text-purple-500">✓</span> In-person or online
                        </li>
                        <li class="flex items-center gap-2 text-slate-700">
                            <span class="text-purple-500">✓</span> Flexible times
                        </li>
                        <li class="flex items-center gap-2 text-slate-700">
                            <span class="text-purple-500">✓</span> Fastest progress
                        </li>
                    </ul>
                    <span class="inline-block bg-purple-500 text-white px-4 py-2 rounded-full font-bold text-sm">Best Results! 🏆</span>
                </div>
            </div>
        </div>
    </section>

    <!-- SCHEDULE PREVIEW SECTION -->
    <section class="py-16 lg:py-24 bg-gradient-to-br from-yellow-50 via-orange-50 to-coral-50">
        <div class="max-w-6xl mx-auto px-4 sm:px-6">
            <div class="text-center mb-12">
                <span class="inline-block text-white px-6 py-2 rounded-full font-bold text-sm mb-4" style="background: #ff6b6b">
                    📅 This Week's Schedule
                </span>
                <h2 class="text-3xl lg:text-5xl font-bold text-slate-800 mb-4" style="font-family: 'Montserrat', sans-serif;">
                    When Are <span class="text-coral-500">Classes</span>? 🗓️
                </h2>
                <p class="text-lg text-slate-600 max-w-2xl mx-auto">Classes run year-round! Here's a sample of our weekly schedule.</p>
            </div>

            <div class="bg-white rounded-[2rem] shadow-xl p-6 lg:p-10 border-4 border-yellow-200">
                <div class="grid md:grid-cols-5 gap-4">
                    <!-- Monday -->
                    <div class="bg-yellow-50 rounded-2xl p-4 border-2 border-yellow-200">
                        <div class="text-center mb-3">
                            <span class="text-2xl">📅</span>
                            <h4 class="font-bold text-slate-800">Monday</h4>
                        </div>
                        <div class="space-y-2">
                            <div class="bg-white rounded-xl p-3 text-center shadow-sm">
                                <p class="text-xs font-bold text-yellow-600">4:00 PM</p>
                                <p class="text-sm font-bold text-slate-800">Beginners</p>
                                <p class="text-xs text-slate-500">Miami</p>
                            </div>
                            <div class="bg-white rounded-xl p-3 text-center shadow-sm">
                                <p class="text-xs font-bold text-coral-600">5:30 PM</p>
                                <p class="text-sm font-bold text-slate-800">Intermediate</p>
                                <p class="text-xs text-slate-500">Online</p>
                            </div>
                        </div>
                    </div>

                    <!-- Tuesday -->
                    <div class="bg-coral-50 rounded-2xl p-4 border-2 border-coral-200">
                        <div class="text-center mb-3">
                            <span class="text-2xl">📅</span>
                            <h4 class="font-bold text-slate-800">Tuesday</h4>
                        </div>
                        <div class="space-y-2">
                            <div class="bg-white rounded-xl p-3 text-center shadow-sm">
                                <p class="text-xs font-bold text-yellow-600">3:30 PM</p>
                                <p class="text-sm font-bold text-slate-800">Beginners</p>
                                <p class="text-xs text-slate-500">Orlando</p>
