    <style>
        .faq-item {
            transition: all 0.3s ease;
        }
        .faq-item:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
        }
        .faq-answer {
            transition: all 0.3s ease;
        }
        .faq-answer:not(.hidden) {
            animation: slideDown 0.3s ease;
        }
        @keyframes slideDown {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        .faq-icon {
            transition: transform 0.3s ease;
        }
        .faq-icon.rotate-180 {
            transform: rotate(180deg);
        }
    </style>

    <script>
        // FAQ Accordion functionality
        document.addEventListener('DOMContentLoaded', function (): void {
            const toggles: NodeListOf<Element> = document.querySelectorAll('.faq-toggle');

            toggles.forEach((toggle: Element): void => {
                toggle.addEventListener('click', function (this: Element): void {
                    const item: Element | null = this.closest('.faq-item');
                    if (!item) return;

                    const answer: Element | null = item.querySelector('.faq-answer');
                    const icon: Element | null = item.querySelector('.faq-icon');
                    if (!answer || !icon) return;

                    const isOpen: boolean = !answer.classList.contains('hidden');

                    // Close all other items
                    document.querySelectorAll('.faq-answer').forEach((a: Element): void => a.classList.add('hidden'));
                    document.querySelectorAll('.faq-icon').forEach((i: Element): void => i.classList.remove('rotate-180'));

                    // Toggle current item
                    if (!isOpen) {
                        answer.classList.remove('hidden');
                        icon.classList.add('rotate-180');
                    }
                });
            });
        });
    </script>
